Cell[TextData[{
 "Izra\[CHacek]unajte:\n1. odvod funkcije ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RadicalBox[
     RowBox[{
      RowBox[{"3", "x"}], "-", "2"}], "3"], 
    SqrtBox[
     RowBox[{
      RowBox[{"2", "x"}], "+", "1"}]]], TraditionalForm]],ExpressionUUID->
  "a8995127-63de-43e4-9b19-ef530a143265"],
 ",\n2. integral ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "\[Pi]"], 
    RowBox[{"x", " ", 
     RowBox[{"sin", " ", "x"}], " ", 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "59f18cf2-4cb6-48b3-815b-dd0c3b0fa355"],
 ",\n3. vsoto ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "1"}], "\[Infinity]"], 
    FractionBox[
     RowBox[{
      SuperscriptBox["k", "2"], "+", "1"}], 
     SuperscriptBox["k", "4"]]}], TraditionalForm]],ExpressionUUID->
  "884ebb17-d051-43e2-8027-e1e122b4fd58"],
 ",\n4. levo limito ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["lim", 
     RowBox[{"x", "\[Rule]", 
      SuperscriptBox["0", "-"]}]], 
    RowBox[{"|", "x", "|", 
     RowBox[{"ctg", " ", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "dada50ae-666f-4a98-a4c2-2be5e4b28a93"],
 "."
}], "Text",ExpressionUUID->"e2b0efd3-22e1-4115-a3d0-738c321f1686"],

