 RowBox[{"(*", 
  RowBox[{"prostor", " ", "za", " ", "va\[SHacek]e", " ", "re\[SHacek]itve"}],
   "*)"}]], "Input",ExpressionUUID->"30510b0a-88af-4d2b-bb70-f6cce6b9cef0"]
